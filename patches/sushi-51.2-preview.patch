--- a/ui/mainWindow.ui
+++ b/ui/mainWindow.ui
@@ -0,0 +1,73 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Derived from the installed GNOME Sushi 51.2 UI; hides the top bar. -->
+<interface>
+  <requires lib="gtk" version="4.0" />
+  <template class="Gjs_MainWindow" parent="AdwApplicationWindow">
+    <property name="content">
+      <object class="AdwToolbarView" id="toolbar_view">
+        <property name="top-bar-style">2</property>
+        <child type="top">
+          <object class="Gjs_ShyBin">
+            <property name="visible">false</property>
+            <property name="child">
+              <object class="AdwHeaderBar" id="titlebar">
+                <binding name="decoration-layout">
+                  <closure function="_getDecorationLayout" type="gchararray" />
+                </binding>
+                <child type="start">
+                  <object class="GtkButton" id="fullscreen_button">
+                    <property name="icon-name">view-fullscreen-symbolic</property>
+                    <property name="action-name">win.fullscreen</property>
+                    <property name="tooltip-text" translatable="yes">Toggle Fullscreen</property>
+                  </object>
+                </child>
+                <child type="end">
+                  <object class="GtkButton">
+                    <property name="icon-name">detach-symbolic</property>
+                    <property name="action-name">win.open-file</property>
+                    <property name="tooltip-text" translatable="yes">Open</property>
+                  </object>
+                </child>
+              </object>
+            </property>
+          </object>
+        </child>
+        <property name="content">
+          <object class="GtkStack" id="mainStack">
+            <property name="visible-child">spinner</property>
+            <child>
+              <object class="GtkStackPage" id="loading">
+                <property name="child">
+                  <object class="AdwSpinner" id="spinner" />
+                </property>
+              </object>
+            </child>
+          </object>
+        </property>
+      </object>
+    </property>
+    <child>
+      <object class="GtkShortcutController">
+        <property name="scope">1</property>
+        <child>
+          <object class="GtkShortcut">
+            <property name="trigger">f</property>
+            <property name="action">action(win.fullscreen)</property>
+          </object>
+        </child>
+        <child>
+          <object class="GtkShortcut">
+            <property name="trigger">F11</property>
+            <property name="action">action(win.fullscreen)</property>
+          </object>
+        </child>
+        <child>
+          <object class="GtkShortcut">
+            <property name="trigger">o</property>
+            <property name="action">action(win.open-file)</property>
+          </object>
+        </child>
+      </object>
+    </child>
+  </template>
+</interface>
