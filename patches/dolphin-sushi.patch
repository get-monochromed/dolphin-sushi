+void DolphinMainWindowTest::testSushiPreviewShortcut()
+{
+    QTemporaryDir helperDir;
+    QVERIFY(helperDir.isValid());
+    const QString outputPath = helperDir.filePath(QStringLiteral("arguments"));
+    QFile launcher(helperDir.filePath(QStringLiteral("sushi")));
+    QVERIFY(launcher.open(QIODevice::WriteOnly));
+    launcher.write("#!/bin/sh\nprintf '%s\\n' \"$@\" >> \"$DOLPHIN_SUSHI_TEST_LOG\"\n");
+    launcher.close();
+    QVERIFY(launcher.setPermissions(QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner));
+    const QByteArray oldPath = qgetenv("PATH");
+    const QByteArray oldLog = qgetenv("DOLPHIN_SUSHI_TEST_LOG");
+    const auto restoreEnvironment = qScopeGuard([&]() {
+        qputenv("PATH", oldPath);
+        if (oldLog.isNull()) {
+            qunsetenv("DOLPHIN_SUSHI_TEST_LOG");
+        } else {
+            qputenv("DOLPHIN_SUSHI_TEST_LOG", oldLog);
+        }
+    });
+    QByteArray testPath = helperDir.path().toUtf8();
+    testPath.append(':').append(oldPath);
+    qputenv("PATH", testPath);
+    qputenv("DOLPHIN_SUSHI_TEST_LOG", outputPath.toUtf8());
+
+    TestDir files;
+    const QUrl fileUrl = QUrl::fromLocalFile(files.filePath(QStringLiteral("preview space ' $name.txt")));
+    const QUrl otherUrl = QUrl::fromLocalFile(files.filePath(QStringLiteral("other.txt")));
+    files.createFile(fileUrl.toLocalFile());
+    files.createFile(otherUrl.toLocalFile());
+    m_mainWindow->openDirectories({files.url()}, false);
+    m_mainWindow->show();
+    QVERIFY(QTest::qWaitForWindowExposed(m_mainWindow.data()));
+    auto *container = m_mainWindow->m_tabWidget->currentTabPage()->activeViewContainer();
+    DolphinView *view = container->view();
+    QTRY_COMPARE(view->itemsCount(), 2);
+    view->forceUrlsSelection(fileUrl, {fileUrl});
+    view->updateViewState();
+    view->setFocus();
+    QTRY_VERIFY(!view->handleSpaceAsNormalKey());
+    QTest::keyClick(QApplication::focusWidget(), Qt::Key_Space);
+    QTRY_VERIFY(QFile::exists(outputPath));
+    QFile output(outputPath);
+    QVERIFY(output.open(QIODevice::ReadOnly));
+    QTRY_COMPARE(output.size(), fileUrl.toString(QUrl::FullyEncoded).toUtf8().size() + 1);
+    QCOMPARE(output.readAll(), fileUrl.toString(QUrl::FullyEncoded).toUtf8() + '\n');
+    QVERIFY(!container->isSelectionModeEnabled());
+
+    // Multiple selections must not launch a preview or enter selection mode.
+    const auto count = output.size();
+    view->forceUrlsSelection(fileUrl, {fileUrl, otherUrl});
+    view->updateViewState();
+    QTest::keyClick(QApplication::focusWidget(), Qt::Key_Space);
+    QTest::qWait(150);
+    QCOMPARE(output.size(), count);
+    QVERIFY(!container->isSelectionModeEnabled());
+
+    // Space in an editor must remain text input.
+    QLineEdit editor(m_mainWindow.data());
+    editor.show();
+    editor.setFocus();
+    QTRY_VERIFY(editor.hasFocus());
+    QTest::keyClick(&editor, Qt::Key_Space);
+    QCOMPARE(editor.text(), QStringLiteral(" "));
+    QCOMPARE(output.size(), count);
+}
+
 void DolphinMainWindowTest::cleanupTestCase()
 {
     m_mainWindow->showNormal();
